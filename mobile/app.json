{
  "expo": {
    "name": "EL MECANO",
    "slug": "elmecano",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elmecano.garage",
      "infoPlist": {
        "NSCameraUsageDescription": "EL MECANO a besoin de la caméra pour photographier les véhicules.",
        "NSPhotoLibraryUsageDescription": "EL MECANO a besoin d'accéder à vos photos pour les documents véhicule.",
        "NSPhotoLibraryAddUsageDescription": "EL MECANO peut enregistrer des photos liées aux véhicules."
      }
    },
    "android": {
      "package": "com.elmecano.garage",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#111827"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EL MECANO a besoin d'accéder à vos photos pour les documents véhicule.",
          "cameraPermission": "EL MECANO a besoin de la caméra pour photographier les véhicules."
        }
      ],
      "expo-audio",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "c6974152-5ed9-4dcf-8b4f-dce96ec12867"
      }
    },
    "owner": "elmecano"
  }
}
